{
  "schemaVersion": 1,
  "source": {
    "repository": "sudipdasin/sudip-das-frontend",
    "directory": "examples/customer-demo",
    "contractPath": "contracts/personal-port-v1.json"
  },
  "destination": {
    "repository": "sudipdasin/sudip-das-profile",
    "sourceDirectory": "site/public",
    "deployment": "separate-private-approved-only"
  },
  "themes": [
    "orbit",
    "editorial",
    "terminal",
    "aurora-peak",
    "neon-studio",
    "design-2"
  ],
  "languageCodes": [
    "en",
    "hi",
    "bn",
    "es",
    "fr",
    "de",
    "pt",
    "ar",
    "zh-CN",
    "ja"
  ],
  "features": [
    {
      "id": "six-themes",
      "publicAssets": [
        "studio-new-themes.css",
        "studio-reference-layout.css"
      ],
      "personalAssets": [
        "webstudio-visual-port.css",
        "webstudio-visual-port.js"
      ],
      "personalMarkers": [
        "data-theme",
        "theme-select"
      ]
    },
    {
      "id": "scene-artwork",
      "publicAssets": [
        "neon-horizon.svg",
        "aurora-reference-horizon.svg",
        "cosmic-reference-wave.svg"
      ],
      "personalAssets": [
        "neon-horizon.svg",
        "aurora-reference-horizon.svg",
        "cosmic-reference-wave.svg"
      ],
      "personalMarkers": [
        "theme-scene"
      ]
    },
    {
      "id": "appearance-local-only",
      "publicAssets": [
        "studio-creative-lab.js"
      ],
      "personalAssets": [
        "webstudio-visual-port.js"
      ],
      "personalMarkers": [
        "schema:'sudip-profile-appearance'",
        "URL.createObjectURL"
      ]
    },
    {
      "id": "portfolio-gallery",
      "publicAssets": [
        "app.js"
      ],
      "personalAssets": [
        "webstudio-portfolio-gallery.js",
        "webstudio-portfolio-gallery.css"
      ],
      "personalMarkers": [
        "profile-showcase",
        "portfolio-project-story"
      ]
    },
    {
      "id": "visitor-hub",
      "publicAssets": [
        "app.js"
      ],
      "personalAssets": [
        "webstudio-visitor-hub.js",
        "webstudio-visitor-hub.css"
      ],
      "personalMarkers": [
        "ws-visitor-hub",
        "ws-tour-start"
      ]
    }
  ],
  "excludedFromPersonal": [
    "fictional Dev Das profile and avatar",
    "public self-service profile editor",
    "unverified payment or publishing controls",
    "LifeSphere private vault and records",
    "demo launch-readiness inspector as certification"
  ],
  "protectedPersonal": [
    "Sudip Das identity and owner-approved project data",
    "actual portrait",
    "private-request-form",
    "Cloudflare Turnstile and API boundaries",
    "release/publication.json approval"
  ],
  "promotion": {
    "direction": "webstudio-to-personal-only",
    "requireHumanReview": true,
    "autoDeploy": false,
    "upstreamContractMustMatch": true,
    "requireBuildAndBrowserAcceptance": true
  }
}
